# Avenue 백엔드 설정 견본 — 이 파일을 같은 폴더에 application.properties로 복사해 쓴다. application.properties는 커밋하지 않는다(.gitignore).
# 비밀값(DB 비밀번호, JWT 키, 개인정보 AES·HMAC 키)은 이 파일에 값으로 적지 않는다. 아래처럼 ${환경변수} 자리로 두고 환경변수로 넣는다.
# 팀 개발 키는 디스코드 비공개 채널의 env 파일 값을 쓴다(docs/spec/sql/dummy_db/README.md 「팀 개발 키로 시드 만들기」). 더미 시드와 같은 키여야 복호화·검색이 맞는다.

# ---- DB (Oracle) — 각자 채운다. 비밀번호는 환경변수로 넣는 것을 권장한다 ----
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

# ---- MyBatis — mapper XML 위치(resources/mapper/<도메인>/*.xml) ----
mybatis.mapper-locations=classpath:mapper/**/*.xml

# ---- FP-87 인증 (avenue.auth.*) ----
# JWT 서명 키: Base64, 디코딩 후 32바이트 이상. 값은 환경변수 AVENUE_JWT_SECRET로만 넣는다.
avenue.auth.jwt.secret=${AVENUE_JWT_SECRET}
# 액세스 토큰 유효 시간(분)
avenue.auth.jwt.expires-minutes=60
# 이메일 인증코드 보내는 방식: LOG(서버 로그, 개발용) | FIXED(정해진 코드) | SMTP(실제 메일)
avenue.auth.email.mode=LOG
# FIXED일 때만 쓰는 고정 인증코드
avenue.auth.email.fixed-code=
# 소셜 로그인: DEV(개발용 가짜 제공자) | REAL(실제 OAuth)
avenue.auth.social.mode=DEV
# 다른 팀 경로를 인증 없이 임시로 열어 둔다(쉼표로 구분). 빼려면 인증 담당에게 말한다(backend/README.md).
avenue.auth.temporary-open-paths=/api/finance/**,/api/diagnosis/**,/api/simulation/**

# ---- CORS — 프론트 개발 서버 주소(쉼표로 여러 개) ----
avenue.cors.allowed-origins=http://localhost:5173

# ---- 대안 데이터 모의 연동 (작업 5에서 씀) ----
# 더미 기관 응답 폴더(service_dummy/external_api). 저장소 밖 경로를 적는다.
avenue.altdata.source-dir=
# 더미 응답에 회원 자료가 없을 때: EMPTY(빈 결과) | BORROW(다른 더미 회원 자료를 빌려 씀)
avenue.altdata.missing-member-mode=EMPTY

# ---- 개인정보 암호화 키 (N-02-4) — Base64. AES는 정확히 32바이트, HMAC은 32바이트 이상, 둘은 서로 달라야 한다 ----
avenue.pii.aes-key=${AVENUE_DEV_AES_KEY}
avenue.pii.hmac-key=${AVENUE_DEV_HMAC_KEY}
