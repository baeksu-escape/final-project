<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- N-18-7 점수대별 참고 금리·한도(SCORE_BAND_OFFER)와 등급(SCORE_GRADE_BAND) 조회 (FP-170) -->
<mapper namespace="com.baeksuescape.finance.mapper.ScoreBandOfferMapper">

    <resultMap id="scoreBandOfferRowMap" type="com.baeksuescape.finance.dto.ScoreBandOfferRow">
        <result property="minScore" column="MIN_SCORE"/>
        <result property="maxScore" column="MAX_SCORE"/>
        <result property="rateMinPct" column="RATE_MIN_PCT"/>
        <result property="rateMaxPct" column="RATE_MAX_PCT"/>
        <result property="rateAvgPct" column="RATE_AVG_PCT"/>
        <result property="limitAmt" column="LIMIT_AMT"/>
        <result property="baseDate" column="BASE_DATE"/>
    </resultMap>

    <resultMap id="gradeBandRowMap" type="com.baeksuescape.finance.dto.GradeBandRow">
        <result property="gradeBandCode" column="GRADE_BAND_CODE"/>
        <result property="cutoffVersion" column="CUTOFF_VERSION"/>
    </resultMap>

    <!-- 점수가 들어가는 점수대 1행. 점수대는 UK_SBO_RANGE로 겹치지 않게 관리된다 -->
    <select id="selectOfferByScore" resultMap="scoreBandOfferRowMap">
        SELECT MIN_SCORE, MAX_SCORE, RATE_MIN_PCT, RATE_MAX_PCT, RATE_AVG_PCT, LIMIT_AMT, BASE_DATE
          FROM SCORE_BAND_OFFER
         WHERE #{score} BETWEEN MIN_SCORE AND MAX_SCORE
         ORDER BY MIN_SCORE
         FETCH FIRST 1 ROWS ONLY
    </select>

    <!-- ACTIVE 등급 구간 버전(동시에 1개만, UX_SCV_ACTIVE)에서 점수에 맞는 등급 -->
    <select id="selectActiveGradeBand" resultMap="gradeBandRowMap">
        SELECT g.GRADE_BAND_CODE, g.CUTOFF_VERSION
          FROM SCORE_GRADE_BAND g
          JOIN SCORE_CUTOFF_VERSION c ON c.CUTOFF_VERSION = g.CUTOFF_VERSION
         WHERE c.STATUS_CODE = 'ACTIVE'
           AND #{score} BETWEEN g.MIN_SCORE AND g.MAX_SCORE
         FETCH FIRST 1 ROWS ONLY
    </select>
</mapper>
